package admin

import (
"fmt"

"scavenger/core/models"
)

templ GroupsPage(user models.User, groups []models.Group) {
<div class="container-fluid mt-4">
	<div class="row mb-4">
		<div class="col">
			<h1 class="h2">
				<i class="fas fa-layer-group me-2"></i>Управление группами
			</h1>
			<p class="text-muted">Создание и управление учебными группами</p>
		</div>
		<div class="col-auto">
			<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createGroupModal">
				<i class="fas fa-plus-circle me-2"></i>Создать группу
			</button>
		</div>
	</div>

	<div class="card">
		<div class="card-body">
			if len(groups) == 0 {
			<div class="text-center py-5">
				<i class="fas fa-layer-group fa-3x text-muted mb-3"></i>
				<h4>Группы не найдены</h4>
				<p class="text-muted">В системе пока нет учебных групп</p>
				<button class="btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#createGroupModal">
					<i class="fas fa-plus-circle me-2"></i>Создать первую группу
				</button>
			</div>
			} else {
			<div class="table-responsive">
				<table class="table table-hover">
					<thead>
						<tr>
							<th>ID</th>
							<th>Название группы</th>
							<th>Дата создания</th>
							<th>Количество студентов</th>
							<th>Действия</th>
						</tr>
					</thead>
					<tbody>
						for _, group := range groups {
						<tr>
							<td>{ fmt.Sprintf("%d", group.ID) }</td>
							<td>
								<strong>{ group.Name }</strong>
							</td>
							<td>
								<small class="text-muted">{ group.CreatedAt.Format("02.01.2006") }</small>
							</td>
							<td>
								if len(group.Students) == 0 {
									<span class="badge bg-info">-</span>
								} else {
									<span class="badge bg-info">{ fmt.Sprintf("%d", len(group.Students)) }</span>
								}
							</td>
							<td>
								<div class="btn-group btn-group-sm" role="group">
									<button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal"
										data-bs-target={ "#editGroupModal" + fmt.Sprintf("%d", group.ID) }>
										<i class="fas fa-edit me-1"></i>Изменить
									</button>
									<form method="POST" action={ fmt.Sprintf("/admin/groups/%d/delete", group.ID) }
										class="d-inline"
										onsubmit="return confirm('Вы уверены, что хотите удалить эту группу?')">
										<button type="submit" class="btn btn-outline-danger btn-sm">
											<i class="fas fa-trash me-1"></i>Удалить
										</button>
									</form>
								</div>
							</td>
						</tr>
						}
					</tbody>
				</table>
			</div>
			}
		</div>
	</div>

	<!-- Модальное окно создания группы -->
	<div class="modal fade" id="createGroupModal" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Создание учебной группы</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<form method="POST" action="/admin/groups/create">
					<div class="modal-body">
						<div class="mb-3">
							<label class="form-label">Название группы *</label>
							<input type="text" class="form-control" name="name" required
								placeholder="Например: ИС-21, ПМИ-22">
							<div class="form-text">Уникальное название учебной группы</div>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
						<button type="submit" class="btn btn-primary">Создать</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
}
