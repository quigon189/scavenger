package admin

import (
"fmt"
"scavenger/core/models"
"time"
)

templ Dashboard(user models.User, stats *models.AdminDashboard, recentCodes []models.RegistrationCode) {
<div class="container-fluid mt-4">
	<div class="row mb-4">
		<div class="col">
			<h1 class="h2"><i class="fas fa-tachometer-alt me-2"></i>Панель управления</h1>
			<p class="text-muted">Обзор системы управления учебным процессом</p>
		</div>
	</div>

	<!-- Статистика: пользователи и группы -->
	<div class="row mb-4">
		<div class="col-md-3">
			<div class="card border-primary">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<h6 class="card-title text-muted">Студенты</h6>
							<h3 class="mb-0">{ fmt.Sprintf("%d", stats.TotalStudents) }</h3>
						</div>
						<div class="bg-primary text-white rounded-circle p-3">
							<i class="fas fa-users fa-2x"></i>
						</div>
					</div>
					<div class="text-center">
						<a href="/admin/students" class="btn btn-outline-primary btn-sm">Перейти</a>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card border-success">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<h6 class="card-title text-muted">Преподаватели</h6>
							<h3 class="mb-0">{ fmt.Sprintf("%d", stats.TotalTeachers) }</h3>
						</div>
						<div class="bg-success text-white rounded-circle p-3">
							<i class="fas fa-chalkboard-teacher fa-2x"></i>
						</div>
					</div>
					<div class="text-center">
						<a href="/admin/teachers" class="btn btn-outline-success btn-sm">Перейти</a>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card border-warning">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<h6 class="card-title text-muted">Группы</h6>
							<h3 class="mb-0">{ fmt.Sprintf("%d", stats.TotalGroups) }</h3>
						</div>
						<div class="bg-warning text-white rounded-circle p-3">
							<i class="fas fa-layer-group fa-2x"></i>
						</div>
					</div>
					<div class="text-center">
						<a href="/admin/groups" class="btn btn-outline-warning btn-sm">Перейти</a>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card border-dark">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<h6 class="card-title text-muted">Коды доступа</h6>
							<h3 class="mb-0">{ fmt.Sprintf("%d", stats.TotalCodes) }</h3>
						</div>
						<div class="bg-dark text-white rounded-circle p-3">
							<i class="fas fa-qrcode fa-2x"></i>
						</div>
					</div>
					<div class="text-center">
						<a href="/admin/codes" class="btn btn-outline-dark btn-sm">Перейти</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Быстрые действия и последние коды -->
	<div class="row">
		<div class="col-md-6">
			<div class="card">
				<div class="card-header">
					<h5 class="card-title mb-0">Быстрые действия</h5>
				</div>
				<div class="card-body">
					<div class="row g-3">
						<div class="col-md-6">
							<a href="/admin/codes" class="btn btn-warning w-100 mb-2">
								<i class="fas fa-qrcode me-2"></i>Управление кодами
							</a>
						</div>
						<div class="col-md-6">
							<a href="/admin/teachers" class="btn btn-primary w-100 mb-2">
								<i class="fas fa-user-plus me-2"></i>Добавить преподавателя
							</a>
						</div>
						<div class="col-md-6">
							<a href="/admin/groups" class="btn btn-success w-100 mb-2">
								<i class="fas fa-plus-circle me-2"></i>Создать группу
							</a>
						</div>
						<div class="col-md-6">
							<a href="/admin/disciplines" class="btn btn-info w-100 mb-2">
								<i class="fas fa-book-medical me-2"></i>Добавить дисциплину
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-6">
			<div class="card">
				<div class="card-header">
					<h5 class="card-title mb-0">Последние созданные коды</h5>
				</div>
				<div class="card-body">
					if len(recentCodes) == 0 {
					<p class="text-muted mb-0">Нет недавних кодов</p>
					} else {
					<div class="list-group list-group-flush">
						for _, code := range recentCodes {
						<div class="list-group-item px-0">
							<div class="d-flex w-100 justify-content-between">
								<h6 class="mb-1"><code>{ code.Code }</code> — { code.Name }</h6>
								<small class="text-muted">{ code.ExpiresAt.Format("02.01.2006") }</small>
							</div>
							<p class="mb-1 small">
								Роль: { code.Role } |
								if code.ExpiresAt.After(time.Now()) {
								<span class="text-success">Активен</span>
								} else {
								<span class="text-danger">Истек</span>
								}
							</p>
						</div>
						}
					</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>
}
