package templates

import (
    "scavenger/internal/csrf"
    "scavenger/internal/domain"
    "scavenger/web/templates/components"
)

templ Layout(title string, user *domain.User, navbar bool) {
    <!DOCTYPE html>
    <html lang="ru">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>{ title }</title>
        <link rel="stylesheet" href="/static/bootstrap.min.css"/>
        <link rel="stylesheet" href="/static/app.css"/>
		<link rel="stylesheet" href="/static/katex.min.css">
        <script src="/static/htmx.min.js" defer></script>
        <script src="/static/app.js" defer></script>
		<script src="/static/bootstrap.bundle.min.js" defer></script>
    </head>
    <body hx-headers={ `{"X-CSRF-Token":"` + csrf.TokenFromCtx(ctx) + `"}` }>
		if navbar {
       		@components.Navbar(user)
		}
        <main class="container py-2" id="main">
            { children... }
        </main>
        <div id="toasts" class="toast-container position-fixed top-0 end-0 p-3"></div>
		<script defer src="/static/katex.min.js"></script>
		<script defer src="/static/katex.min.js"
			    onload="renderMathInElement(document.body, {
					delimiters: [
						{left: '$$', right: '$$', display: true},
						{left: '$', right: '$', display: false},
						{left: '\\[', right: '\\]', display: true},
						{left: '\\(', right: '\\(', display: false}
					],
					throwOnError: false
					});"></script>
    </body>
    </html>
}
