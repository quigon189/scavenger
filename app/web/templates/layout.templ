package templates

import (
    "scavenger/internal/csrf"
    "scavenger/internal/domain"
    "scavenger/web/templates/components"
)

templ Layout(title string, user *domain.User) {
    <!DOCTYPE html>
    <html lang="ru">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>{ title }</title>
        <link rel="stylesheet" href="/static/bootstrap.min.css"/>
        <link rel="stylesheet" href="/static/app.css"/>
        <script src="/static/htmx.min.js" defer></script>
        <script src="/static/app.js" defer></script>
    </head>
    <body hx-headers={ `{"X-CSRF-Token":"` + csrf.TokenFromCtx(ctx) + `"}` }>
        @components.Navbar(user)
        <main class="container py-4" id="main">
            { children... }
        </main>
        <div id="toasts" class="toast-container position-fixed top-0 end-0 p-3"></div>
    </body>
    </html>
}
