package components

import (
	"scavenger/internal/domain"
	"scavenger/internal/routes"
)

templ Navbar(user *domain.User) {
	<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
		<div class="container-fluid">
			<a class="navbar-brand" href={ routes.Home }>Scavenger</a>
			if user != nil {
				<div class="ms-auto d-flex align-items-center gap-3 text-light">
					<span>{ user.FullName } ({ user.ViewRole() })</span>
					<form method="post" action={ routes.Logout }>
						<button class="btn btn-outline-light btn-sm">Выйти</button>
					</form>
				</div>
			} else {
				<a class="btn btn-outline-light btn-sm ms-auto" href={ routes.Login }>Войти</a>
			}
		</div>
	</nav>
}
