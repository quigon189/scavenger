package components

import (
	"fmt"
	"time"
)

// ---------- Заметка ----------

templ NoteCard(v NoteCardView) {
	<article class="card mb-3 border-warning-subtle bg-warning-subtle bg-opacity-10">
		<div class="card-body">
			<h6 class="card-title mb-2">
				<b>{ v.Material.Title }</b>
			</h6>
			<p class="card-text mb-0">{ v.Material.Description }</p>
		</div>
	</article>
}

// ---------- Теория ----------

templ TheoryCard(v TheoryCardView) {
	<article class="card mb-3 shadow-sm position-relative card-hoverable">
		<div class="card-body">
			<h5 class="card-title mb-1">
				<a href={ templ.SafeURL("/material/" + v.Material.ID) }
					class="stretched-link text-decoration-none text-reset">
					<b>{ v.Material.Title }</b>
				</a>
			</h5>
		</div>
	</article>
}

// ---------- Практика ----------

templ PracticalCard(v PracticalCardView) {
	<article class="card mb-3 shadow-sm position-relative card-hoverable">
		<div class="card-body">
			<div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-1">
				<h5 class="card-title mb-0">
					<a href={ templ.SafeURL("/material/" + v.Material.ID) }
						class="stretched-link text-decoration-none text-reset">
						<b>Практическое занятие №{ fmt.Sprintf("%d", v.Material.Number) }:</b> { v.Material.Title }
					</a>
				</h5>
				if !v.Material.Deadline.IsZero() {
					@deadlineBadge(v.Material.Deadline)
				}
			</div>

			if v.Grade != nil || v.Progress != nil {
				<div class="mt-3 d-flex align-items-center gap-3">
					if v.Grade != nil {
						@gradeBadge(*v.Grade)
					}
					if v.Progress != nil {
						@progressBar(*v.Progress)
					}
				</div>
			}
		</div>
	</article>
}

// ---------- Общие бейджи/виджеты ----------

templ deadlineBadge(deadline time.Time) {
	if time.Now().After(deadline) {
		<span class="badge text-bg-danger">Просрочено</span>
	} else {
		<span class="badge text-bg-info">
			До { deadline.Format("02.01.2006 15:04") }
		</span>
	}
}

templ gradeBadge(grade int) {
	{{ class := "badge text-bg-success" }}
	switch {
	case grade < 3:
		{{ class = "badge text-bg-danger" }}
	case grade < 4:
		{{ class = "badge text-bg-warning" }}
	}
	<span class={ class }>Оценка: { fmt.Sprintf("%d", grade) }</span>
}

templ progressBar(p Progress) {
	<div class="progress flex-grow-1" style="max-width: 220px; height: 8px;"
		role="progressbar"
		aria-valuenow={ fmt.Sprintf("%d", p.Percent()) }
		aria-valuemin="0"
		aria-valuemax="100"
	>
		<div class="progress-bar" style={ "width: " + fmt.Sprintf("%d", p.Percent()) + "%" }></div>
	</div>
	<span class="small text-body-secondary">
		{ fmt.Sprintf("%d/%d", p.Done, p.Total) }
	</span>
}

// ---------- Список ----------

templ MaterialList(items []MaterialCardView) {
	<div class="d-flex flex-column gap-3">
		for _, it := range items {
			@MaterialCard(it)
		}
	</div>
}

templ MaterialCard(v MaterialCardView) {
	if v.Note != nil {
		@NoteCard(*v.Note)
	} else if v.Theory != nil {
		@TheoryCard(*v.Theory)
	} else if v.Practical != nil {
		@PracticalCard(*v.Practical)
	}
}
