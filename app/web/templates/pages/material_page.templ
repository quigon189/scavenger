package pages

import (
	"scavenger/internal/domain"
	"scavenger/web/templates"
	"scavenger/web/templates/components"
	"scavenger/web/templates/viewmodels"
)

templ MaterialPage(u *domain.User, v viewmodels.MaterialPageView) {
	@templates.Layout(components.MaterialTitle(v), u, true) {
		<div class="container py-4">
			@components.MaterialBreadcrumbs(v)
			@components.MaterialHeader(v)
			<article class="card mb-3">
				<div class="card-body">
					@components.MaterialBody(v)
				</div>
			</article>
			@components.MaterialNav(v)
		</div>
	}
}
