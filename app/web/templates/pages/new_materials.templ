package pages

import (
	"scavenger/internal/domain"
	"scavenger/web/templates"
)

templ MaterialNewNotePage(u *domain.User, d domain.Discipline, csrf string, errMsg string) {
	@materialNewForm(u, d, csrf, "Заметка", "", errMsg) {
		<div class="mb-3">
			<label class="form-label" for="description">Текст заметки</label>
			<textarea id="description" name="description" class="form-control" rows="4" required></textarea>
		</div>
	}
}

templ MaterialNewTheoryPage(u *domain.User, d domain.Discipline, csrf string, errMsg string) {
	@materialNewForm(u, d, csrf, "Теория", "", errMsg) {
		<div class="mb-3">
			<label class="form-label" for="content">Содержимое (Markdown)</label>
			<textarea id="content" name="content" class="form-control font-monospace"
				rows="15" required></textarea>
			<div class="form-text">
				Поддерживается Markdown: заголовки, списки, таблицы, формулы ($...$ и $$...$$).
			</div>
		</div>
	}
}

templ MaterialNewPracticalPage(u *domain.User, d domain.Discipline, csrf string, errMsg string) {
	@materialNewForm(u, d, csrf, "Практика", "", errMsg) {
		<div class="row g-3 mb-3">
			<div class="col-md-3">
				<label class="form-label" for="number">Номер работы</label>
				<input type="number" id="number" name="number" class="form-control"
					min="1" required/>
			</div>
			<div class="col-md-9">
				<label class="form-label" for="deadline">Дедлайн</label>
				<input type="datetime-local" id="deadline" name="deadline" class="form-control" required/>
			</div>
		</div>

		<div class="mb-3">
			<label class="form-label" for="content">Содержимое (Markdown)</label>
			<textarea id="content" name="content" class="form-control font-monospace"
				rows="15" required></textarea>
			<div class="form-text">
				Поддерживается Markdown: заголовки, списки, таблицы, формулы ($...$ и $$...$$).
			</div>
		</div>
	}
}

templ materialNewForm(u *domain.User, d domain.Discipline, csrf string, kind, action string, errMsg string) {
	@templates.Layout("Новый материал · "+kind, u, true) {
		<div class="container py-4" style="max-width: 780px;">
			<nav aria-label="breadcrumb">
				<ol class="breadcrumb small">
					<li class="breadcrumb-item"><a href="/">Главная</a></li>
					<li class="breadcrumb-item">
						<a href={ templ.SafeURL("/discipline/" + itoa(d.ID)) }>{ d.Title }</a>
					</li>
					<li class="breadcrumb-item active">
						Новый материал: { kind }
					</li>
				</ol>
			</nav>

			<h1 class="h4 mb-3">Новый материал: { kind }</h1>

			if errMsg != "" {
				<div class="alert alert-danger" role="alert">{ errMsg }</div>
			}

			<form method="post" action={ templ.SafeURL(action) }>
				<input type="hidden" name="_csrf" value={ csrf }/>

				<div class="mb-3">
					<label class="form-label" for="title">Название</label>
					<input type="text" id="title" name="title" class="form-control" required/>
				</div>

				{ children... }

				<div class="form-check mb-3">
					<input type="checkbox" id="visible" name="visible" class="form-check-input" checked/>
					<label class="form-check-label" for="visible">Показывать студентам</label>
				</div>

				<div class="d-flex gap-2">
					<button type="submit" class="btn btn-primary">Создать</button>
					<a href={ templ.SafeURL("/discipline/" + itoa(d.ID)) }
						class="btn btn-outline-secondary">Отмена</a>
				</div>
			</form>
		</div>
	}
}
