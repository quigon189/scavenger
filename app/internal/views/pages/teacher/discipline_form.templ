package teacher

import (
"scavenger/internal/models"
"strconv"
)

templ DisciplineForm(user models.User, discipline *models.Discipline, groups []models.Group, periods []models.Period) {
<div class="container-fluid mt-4">
	<div class="row mb-4">
		<div class="col">
			<h1 class="h2">
				<i class="fas fa-book me-2"></i>
				if discipline == nil {
				Создание дисциплины
				} else {
				Редактирование дисциплины
				}
			</h1>
		</div>
	</div>

	<div class="card">
		<div class="card-body">
			{{
			url := "/teacher/disciplines/create"
			if discipline!=nil {
			url = "/teacher/disciplines/" + strconv.Itoa(discipline.ID) + "/edit"
			}
			}}
			<form method="POST" action={ templ.URL(url) }>
				<div class="mb-3">
					<label class="form-label">Название дисциплины *</label>
					if discipline != nil {
					<input type="text" class="form-control" name="name" required value={ discipline.Name }
						placeholder="Например: Программирование на Go">
					} else {
					<input type="text" class="form-control" name="name" required value={ "" }
						placeholder="Например: Программирование на Go">
					}
				</div>

				<div class="mb-3">
					<label class="form-label">Группа *</label>
					<select class="form-select" name="group_id" required>
						<option value="">Выберите группу</option>
						for _, g := range groups {
						<option value={ strconv.Itoa(g.ID) } selected?={ discipline != nil && discipline.GroupID==g.ID }>
							{ g.Name }
						</option>
						}
					</select>
				</div>

				<div class="mb-3">
					<label class="form-label">Период *</label>
					<select class="form-select" name="period_id" required>
						<option value="">Выберите период</option>
						for _, p := range periods {
						<option value={ strconv.Itoa(p.ID) } selected?={ discipline !=nil && discipline.PeriodID==p.ID }>
							{ p.Name }
						</option>
						}
					</select>
				</div>

				<div class="mb-3">
					<label class="form-label">Описание</label>
					if discipline != nil {
					<textarea class="form-control" name="description" rows="4"
						placeholder="Краткое описание дисциплины">{ discipline.Description }</textarea>
					} else {
					<textarea class="form-control" name="description" rows="4"
						placeholder="Краткое описание дисциплины"></textarea>
					}

				</div>

				<div class="d-flex gap-2">
					<button type="submit" class="btn btn-primary">
						<i class="fas fa-save me-2"></i>
						if discipline == nil {
						Создать
						} else {
						Сохранить
						}
					</button>
					<a href="/teacher/dashboard" class="btn btn-secondary">
						<i class="fas fa-times me-2"></i>Отмена
					</a>
				</div>
			</form>
		</div>
	</div>
</div>
}
