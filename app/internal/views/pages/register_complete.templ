package pages

templ RegisterComplete(name string, email string, groupName string, role string) {
<div class="container mt-4 vh-100 d-flex justify-content-center">
	<div class="card shadow-sm" style="width: 500px;">
		<div class="card-header bg-primary text-white text-center">
			<h4 class="card-title mb-0">
				<i class="fas fa-user-plus me-2"></i>
				Завершение регистрации
			</h4>
		</div>
		<div class="card-body p-4">
			<div class="alert alert-info mb-4">
				<p class="mb-0">
					Пожалуйста, придумайте логин и пароль для входа в систему.
				</p>
			</div>

			<form method="POST" action="/register/complete">
				<!-- Скрытые поля с данными из кода -->
				<input type="hidden" name="name" value={ name }>
				<input type="hidden" name="email" value={ email }>
				<input type="hidden" name="role" value={ role }>
				if groupName != "" {
				<input type="hidden" name="group_name" value={ groupName }>
				}

				<div class="mb-3">
					<label class="form-label">Имя (из приглашения)</label>
					<input type="text" class="form-control" value={ name } readonly disabled>
				</div>
				<div class="mb-3">
					<label class="form-label">Email (из приглашения)</label>
					<input type="email" class="form-control" value={ email } readonly disabled>
				</div>
				if role == "student" {
				<div class="mb-3">
					<label class="form-label">Группа</label>
					<input type="text" class="form-control" value={ groupName } readonly disabled>
				</div>
				}
				<div class="mb-3">
					<label class="form-label">Логин *</label>
					<input type="text" class="form-control" name="username" required placeholder="Придумайте логин">
					<div class="form-text">Логин должен быть уникальным</div>
				</div>
				<div class="mb-3">
					<label class="form-label">Пароль *</label>
					<input type="password" class="form-control" name="password" required
						placeholder="Минимум 8 символов">
					<div class="form-text">Минимум 8 символов</div>
				</div>

				<div class="d-grid gap-2">
					<button type="submit" class="btn btn-primary btn-lg">
						<i class="fas fa-check-circle me-2"></i>
						Зарегистрироваться
					</button>
					<a href="/login" class="btn btn-outline-secondary">
						<i class="fas fa-times me-2"></i>
						Отмена
					</a>
				</div>
			</form>
		</div>
	</div>
</div>
}
