package admin

import (
"fmt"

"scavenger/internal/models"
)

templ StudentsPage(students []models.Student) {
<div class="container-fluid mt-4">
	<div class="row mb-4">
		<div class="col">
			<h1 class="h2">
				<i class="fas fa-users me-2"></i>Управление студентами
			</h1>
			<p class="text-muted">Подтверждение регистрации и управление студентами</p>
		</div>
	</div>

	<div class="card">
		<div class="card-body">
			if len(students) == 0 {
			<div class="text-center py-5">
				<i class="fas fa-user-friends fa-3x text-muted mb-3"></i>
				<h4>Студенты не найдены</h4>
				<p class="text-muted">
					"В системе пока нет студентов"
				</p>
			</div>
			} else {
			<div class="table-responsive">
				<table class="table table-hover">
					<thead>
						<tr>
							<th>ID</th>
							<th>ФИО</th>
							<th>Логин</th>
							<th>Email</th>
							<th>Группа</th>
							<th>Дата регистрации</th>
							<th>Действия</th>
						</tr>
					</thead>
					<tbody>
						for _, student := range students {
						<tr>
							<td>{ fmt.Sprintf("%d", student.ID) }</td>
							<td>
								<strong>{ student.User.Name }</strong>
							</td>
							<td>{ student.User.Username }</td>
							<td>{ student.User.Email }</td>
							<td>
								<span class="badge bg-secondary">{ student.Group.Name }</span>
							</td>
							<td>
								<small class="text-muted">{ student.CreatedAt.Format("02.01.2006 15:04") }</small>
							</td>
							<td>
								<div class="btn-group btn-group-sm" role="group">
								</div>
							</td>
						</tr>
						}
					</tbody>
				</table>
			</div>
			}
		</div>
	</div>
</div>
}
