package admin

import (
"fmt"

"scavenger/internal/models"
)

templ TeachersPage(teachers []models.Teacher) {
<div class="container-fluid mt-4">
	<div class="row mb-4">
		<div class="col">
			<h1 class="h2">
				<i class="fas fa-chalkboard-teacher me-2"></i>Управление преподавателями
			</h1>
			<p class="text-muted">Регистрация и управление преподавателями системы</p>
		</div>
		<div class="col-auto">
			<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTeacherModal">
				<i class="fas fa-user-plus me-2"></i>Добавить преподавателя
			</button>
		</div>
	</div>

	<div class="card">
		<div class="card-body">
			if len(teachers) == 0 {
			<div class="text-center py-5">
				<i class="fas fa-chalkboard-teacher fa-3x text-muted mb-3"></i>
				<h4>Преподаватели не найдены</h4>
				<p class="text-muted">В системе пока нет зарегистрированных преподавателей</p>
				<button class="btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#createTeacherModal">
					<i class="fas fa-user-plus me-2"></i>Добавить первого преподавателя
				</button>
			</div>
			} else {
			<div class="table-responsive">
				<table class="table table-hover">
					<thead>
						<tr>
							<th>ID</th>
							<th>ФИО</th>
							<th>Email</th>
							<th>Дата регистрации</th>
							<th>Действия</th>
						</tr>
					</thead>
					<tbody>
						for _, teacher := range teachers {
						<tr>
							<td>{ fmt.Sprintf("%d", teacher.ID) }</td>
							<td>
								<strong>{ teacher.User.Name }</strong>
							</td>
							<td>{ teacher.User.Email }</td>
							<td>
								<small class="text-muted">{ teacher.CreatedAt.Format("02.01.2006 15:04") }</small>
							</td>
							<td>
								<form method="POST" action={ fmt.Sprintf("/admin/teachers/%d/delete", teacher.ID) }
									class="d-inline"
									onsubmit="return confirm('Вы уверены, что хотите удалить этого преподавателя?')">
									<button type="submit" class="btn btn-danger btn-sm">
										<i class="fas fa-trash me-1"></i>Удалить
									</button>
								</form>
							</td>
						</tr>
						}
					</tbody>
				</table>
			</div>
			}
		</div>
	</div>

	<!-- Модальное окно создания преподавателя -->
	<div class="modal fade" id="createTeacherModal" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Добавление преподавателя</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<form method="POST" action="/admin/teachers/create">
					<div class="modal-body">
						<div class="mb-3">
							<label class="form-label">ФИО *</label>
							<input type="text" class="form-control" name="name" required
								placeholder="Иванов Иван Иванович">
						</div>
						<div class="mb-3">
							<label class="form-label">Логин *</label>
							<input type="text" class="form-control" name="username" required
								placeholder="Уникальный логин">
						</div>
						<div class="mb-3">
							<label class="form-label">Email</label>
							<input type="email" class="form-control" name="email" placeholder="teacher@example.com">
						</div>
						<div class="mb-3">
							<label class="form-label">Пароль *</label>
							<input type="password" class="form-control" name="password" required
								placeholder="Минимум 8 символов">
							<div class="form-text">Пароль будет отправлен преподавателю</div>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
						<button type="submit" class="btn btn-primary">Создать</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
}
